---
interface Props{
  title:string;
  url:string;
  compact?:boolean;
}
const {title,url,compact=false}=Astro.props;
const encodedUrl=encodeURIComponent(url);
const facebookUrl='https://www.facebook.com/sharer/sharer.php?u='+encodedUrl;
const xUrl='https://twitter.com/intent/tweet?text='+encodeURIComponent(title+' — La Forja')+'&url='+encodedUrl;
const linkedinUrl='https://www.linkedin.com/sharing/share-offsite/?url='+encodedUrl;
---
<section class:list={['article-share',{'article-share-compact':compact}]} aria-label="Compartir esta publicación" data-article-share data-share-url={url} data-share-title={title}>
  <strong class="article-share-heading">{compact?'Compartir':'Comparte esta publicación'}</strong>
  <div class="article-share-actions">
    <a class="article-share-action" href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en Facebook">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.7 21v-8.1h2.7l.4-3.1h-3.1V7.8c0-.9.3-1.5 1.6-1.5H17V3.5c-.3-.1-1.3-.2-2.4-.2-2.4 0-4.1 1.5-4.1 4.2v2.3H7.8v3.1h2.7V21h3.2z"/></svg>
      <span>Facebook</span>
    </a>
    <a class="article-share-action" href={xUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en X (Twitter)">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3H21l-7 8 8.2 10H15.8l-5-6.1L5.5 21H2.3l7.5-8.7L2 3h6.6l4.5 5.6L17.8 3zm-1.1 16.2h1.8L7.6 4.7H5.7z"/></svg>
      <span>X (Twitter)</span>
    </a>
    <a class="article-share-action" href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Compartir en LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5.4 8.7H2.5V21h2.9V8.7zM3.9 3.1a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zM21 14c0-3.3-1.8-5.2-4.2-5.2-1.9 0-2.8 1-3.2 1.7V8.7h-3V21h3v-6.8c0-1.8.7-2.9 2.3-2.9 1.5 0 2.1 1.1 2.1 2.9V21h3V14z"/></svg>
      <span>LinkedIn</span>
    </a>
    <button class="article-share-action" type="button" data-share-copy="instagram" title="Copiar enlace para usarlo en Instagram" aria-label="Copiar enlace para compartir en Instagram">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.7" r=".9" fill="currentColor" stroke="none"/></svg>
      <span>Instagram</span>
    </button>
    <button class="article-share-action" type="button" data-share-copy="link" aria-label="Copiar enlace de la publicación">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="1"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
      <span>Copiar enlace</span>
    </button>
    <button class="article-share-action article-share-native" type="button" data-share-native hidden aria-label="Abrir menú de compartir del dispositivo">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V3m0 0L7.5 7.5M12 3l4.5 4.5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
      <span>Más opciones</span>
    </button>
  </div>
  <p class="article-share-feedback" data-share-feedback role="status" aria-live="polite" hidden></p>
</section>

<script>
  function fallbackCopy(text:string):boolean{
    const field=document.createElement('textarea');
    field.value=text;
    field.setAttribute('readonly','');
    field.style.position='fixed';
    field.style.opacity='0';
    field.style.left='-9999px';
    document.body.appendChild(field);
    field.select();
    let copied=false;
    try{copied=document.execCommand('copy');}catch{}
    field.remove();
    return copied;
  }
  for(const block of document.querySelectorAll<HTMLElement>('[data-article-share]')){
    const url=block.dataset.shareUrl || window.location.origin+window.location.pathname;
    const title=block.dataset.shareTitle || document.title;
    const feedback=block.querySelector<HTMLElement>('[data-share-feedback]');
    const report=(message:string)=>{
      if(feedback){feedback.textContent=message;feedback.hidden=false;}
    };
    for(const button of block.querySelectorAll<HTMLButtonElement>('[data-share-copy]')){
      button.addEventListener('click',async()=>{
        let copied=false;
        if(navigator.clipboard?.writeText){
          try{await navigator.clipboard.writeText(url);copied=true;}catch{}
        }
        if(!copied)copied=fallbackCopy(url);
        const instagram=button.dataset.shareCopy==='instagram';
        report(copied
          ?(instagram?'Enlace copiado. Pégalo en una historia (sticker de enlace) o mensaje de Instagram.':'Enlace copiado al portapapeles.')
          :'No se pudo copiar automáticamente. Copia la dirección: '+url);
      });
    }
    const native=block.querySelector<HTMLButtonElement>('[data-share-native]');
    if(native && typeof navigator.share==='function'){
      native.hidden=false;
      native.addEventListener('click',async()=>{
        try{await navigator.share({title,text:title+' — La Forja',url});}
        catch(error){if(!(error instanceof DOMException && error.name==='AbortError'))report('No se pudo abrir el menú para compartir. Usa «Copiar enlace».');}
      });
    }
  }
</script>
